#!/usr/bin/env bash
set -euo pipefail

tool_name="s3proxy"
install_type="$ASDF_INSTALL_TYPE"
version="$ASDF_INSTALL_VERSION"
install_path="$ASDF_INSTALL_PATH"
download_path="$ASDF_DOWNLOAD_PATH"

if [ "$install_type" != "version" ]; then
  echo "asdf-$tool_name supports data-type 'version' only (got: $install_type)" >&2
  exit 1
fi

(
  shopt -s nullglob
  archives=("$download_path"/*.tar.gz)

  echo "Installing $tool_name v$version..."

  if [ "${#archives[@]}" -ne 1 ]; then
    echo "Expected exactly one release archive in $download_path, found ${#archives[@]}." >&2
    exit 1
  fi

  entries=$(tar -tzf "${archives[0]}")
  if [ "$entries" != "$tool_name" ] && [ "$entries" != "${tool_name}.exe" ]; then
    echo "Release archive must contain exactly one $tool_name binary." >&2
    exit 1
  fi
  case "$entries" in /*|*../*) echo "Unsafe archive path: $entries" >&2; exit 1 ;; esac
  test "$(tar -tvzf "${archives[0]}" | cut -c1)" = "-" || { echo "Release binary is not a regular file." >&2; exit 1; }

  parent=$(dirname "$install_path")
  mkdir -p "$parent"
  stage=$(mktemp -d "$parent/.${tool_name}.install.XXXXXX")
  trap 'rm -rf "$stage"' EXIT
  mkdir "$stage/bin"
  tar -xzf "${archives[0]}" --no-same-owner --no-same-permissions -C "$stage/bin"
  test -f "$stage/bin/$entries" && test ! -L "$stage/bin/$entries"
  chmod 0755 "$stage/bin/$entries"
  mkdir -p "$install_path"
  test ! -e "$install_path/bin" || { echo "Install path already contains bin/" >&2; exit 1; }
  mv "$stage/bin" "$install_path/bin"
  rmdir "$stage"
  trap - EXIT

  echo "$tool_name v$version installation was successful!"
) || {
  echo "Error: Installation failed." >&2
  exit 1
}
