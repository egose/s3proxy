#!/usr/bin/env bash
set -euo pipefail

tool_name="s3proxy"

github_coordinates="${ASDF_S3PROXY_GITHUB_REPOSITORY:-egose/s3proxy}"
base_download_url="https://github.com/${github_coordinates}/releases/download"

version="$ASDF_INSTALL_VERSION"
download_path="$ASDF_DOWNLOAD_PATH"

[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]] || {
  echo "Invalid version: $version" >&2
  exit 1
}

case "$(uname -s)" in
  Darwin) os="darwin" ;;
  Linux)  os="linux"  ;;
  FreeBSD) os="freebsd" ;;
  OpenBSD) os="openbsd" ;;
  NetBSD)  os="netbsd"  ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  x86_64|amd64) arch="amd64" ;;
  arm64|aarch64) arch="arm64" ;;
  i386|i686) arch="386" ;;
  armv7l|arm) arch="arm" ;;
  *) echo "Unsupported arch: $(uname -m)" >&2; exit 1 ;;
esac

filename="${tool_name}-${os}-${arch}.tar.gz"

mkdir -p "$download_path"
download_url="${base_download_url}/v${version}/${filename}"
outfile="${download_path}/${filename}"
checksums="${download_path}/SHA256SUMS"
tmp="${outfile}.tmp"
trap 'rm -f "$tmp" "${checksums}.tmp"' EXIT

echo "Attempting to download: $download_url"

curl -fsSL --connect-timeout 10 --retry 3 "$download_url" -o "$tmp"
curl -fsSL --connect-timeout 10 --retry 3 "${base_download_url}/v${version}/SHA256SUMS" -o "${checksums}.tmp"
expected=$(awk -v file="$filename" '$2 == file || $2 == "*" file { print $1 }' "${checksums}.tmp")
[[ "$expected" =~ ^[0-9a-fA-F]{64}$ ]] || { echo "Missing checksum for $filename" >&2; exit 1; }
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$tmp" | awk '{print $1}')
else
  actual=$(shasum -a 256 "$tmp" | awk '{print $1}')
fi
test "$actual" = "$expected" || { echo "Checksum mismatch for $filename" >&2; exit 1; }
mv "$tmp" "$outfile"
mv "${checksums}.tmp" "$checksums"
trap - EXIT
echo "Download and checksum verification successful."
