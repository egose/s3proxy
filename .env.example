MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=access-key
MINIO_SECRET_KEY=secret-key
MINIO_BUCKET=testbucket

# SeaweedFS S3 endpoint (proxied through s3proxy for integration tests)
SEAWEEDFS_URL=http://127.0.0.1:8333
SEAWEEDFS_BUCKET=testbucket

# s3proxy inbound client credentials (used by integration tests to sign
# requests against the proxy). The matching `auth "main" { client "ci" ... }`
# block must be configured in the s3proxy config file.
S3PROXY_CLIENT_CI_ACCESS_KEY=test-client-ak
S3PROXY_CLIENT_CI_SECRET_KEY=test-client-sk

# s3proxy target credentials (used by s3proxy to sign outbound requests to
# the configured S3-compatible backends). For MinIO this should match a
# service account created by `minio-init`; for SeaweedFS this matches the
# sandbox S3 identity defined in `sandbox/seaweedfs-s3.json`.
S3PROXY_TARGET_PRIMARY_ACCESS_KEY=access-key
S3PROXY_TARGET_PRIMARY_SECRET_KEY=secret-key
S3PROXY_TARGET_REPLICA_ACCESS_KEY=anonymous
S3PROXY_TARGET_REPLICA_SECRET_KEY=anonymous
AZURITE_URL=http://127.0.0.1:10000
AZURITE_ACCOUNT_NAME=account-name
AZURITE_ACCOUNT_KEY=account-key
AZURITE_CONTAINER=testcontainer

FAKE_GCP_PORT=8080
FAKE_GCP_BUCKET=testbucket
